# budgets from runs that compared one revision with itself, rendered as the
# bench/budgets.nix a calibration commits
{ lib, dirs }:
let
  analysis = import ./. { inherit lib; };
  compared = map (
    dir:
    let
      result = analysis.compare (import ./records.nix { inherit lib dir; });
    in
    if result._tag == "refused" then
      throw "calibration run ${toString dir} was refused, ${lib.concatStringsSep "; " result.reasons}"
    else if result.run.baseline.revision != result.run.candidate.revision then
      throw "calibration run ${toString dir} compares two revisions, so its moves aren't noise"
    else
      result
  ) dirs;
  budgets = analysis.calibrate compared;
in
''
  # generated by lexicon-bench calibrate from ${toString budgets.calibration.runs} runs of one revision
  # against itself. a tolerance is twice the largest move observed, never below
  # the policy in bench/analysis/verdicts.nix. recalibrate when bench-evaluator
  # changes, since budgets judge nothing on another evaluator
  ${lib.generators.toPretty { } budgets}
''
